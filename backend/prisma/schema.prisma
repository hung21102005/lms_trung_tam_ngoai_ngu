// ==============================================================================
// PRISMA SCHEMA — HỆ THỐNG QUẢN LÝ HỌC TẬP (LMS) TRUNG TÂM NGOẠI NGỮ
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserStatus {
  PENDING_ACTIVATION // Chưa kích hoạt & đổi mật khẩu lần đầu
  ACTIVE // Hoạt động bình thường
  INACTIVE // Tạm ngưng
  LOCKED // Bị khóa do vi phạm hoặc nghỉ học/nghỉ việc
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LeadStatus {
  NEW // Mới đăng ký tư vấn
  CONTACTED // Đã liên hệ
  TEST_SCHEDULED // Đã hẹn lịch kiểm tra trình độ đầu vào
  ENROLLED // Đã nhập học chính thức (chuyển đổi thành học viên)
  CANCELLED // Hủy hoặc không có nhu cầu
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  ZALO
  DIRECT_WALKIN
  REFERRAL
  OTHER
}

enum ClassStatus {
  PLANNING // Đang lập kế hoạch
  OPEN_FOR_ENROLLMENT // Đang mở đăng ký tuyển sinh
  IN_PROGRESS // Đang diễn ra
  COMPLETED // Đã kết thúc khóa học
  CANCELLED // Đã hủy
}

enum EnrollmentStatus {
  ENROLLED // Đang theo học chính thức
  RESERVED // Bảo lưu kết quả
  DROPPED // Thôi học
  TRANSFERRED // Đã chuyển lớp
}

enum SessionStatus {
  SCHEDULED // Đã lên lịch
  IN_PROGRESS // Đang diễn ra
  COMPLETED // Đã hoàn thành (đã điểm danh)
  CANCELLED // Nghỉ buổi này
  MAKEUP_SCHEDULED // Buổi học bù
}

enum MaterialFileType {
  PDF
  AUDIO
  VIDEO
  IMAGE
  DOCUMENT
  OTHER
}

enum AttendanceStatus {
  PRESENT // Có mặt
  ABSENT // Vắng không phép
  LATE // Đi muộn
  EXCUSED // Vắng có phép
  MAKEUP // Đã học bù
}

enum MakeupStatus {
  PENDING // Chờ phê duyệt
  APPROVED // Đã đồng ý cho học bù
  REJECTED // Từ chối
  COMPLETED // Đã hoàn thành buổi học bù
}

enum AssignmentType {
  HOMEWORK // Bài tập về nhà
  PROJECT // Dự án / Bài nhóm
  SPEAKING // Bài tập ghi âm phát âm / nói
  WRITING // Bài luận / viết
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  DRAFT // Bản nháp chưa nộp
  SUBMITTED // Đã nộp bài
  GRADED // Đã chấm điểm
  RETURNED // Yêu cầu làm lại / trả bài
  LATE // Nộp muộn
}

enum QuestionType {
  MULTIPLE_CHOICE // Trắc nghiệm nhiều lựa chọn
  FILL_BLANK // Điền vào chỗ trống
  MATCHING // Nối cặp đáp án
  ORDERING // Sắp xếp theo thứ tự
  ESSAY // Tự luận
}

enum ExamStatus {
  DRAFT // Bản nháp
  PUBLISHED // Đã mở đề thi cho học viên
  CLOSED // Đã kết thúc / đóng kỳ thi
}

enum AttemptStatus {
  IN_PROGRESS // Đang làm bài
  SUBMITTED // Đã nộp bài
  GRADED // Đã chấm xong
  EXPIRED // Hết thời gian làm bài
}

enum InvoiceStatus {
  DRAFT // Bản nháp
  PENDING // Chờ thanh toán
  PARTIALLY_PAID // Thanh toán một phần
  PAID // Đã thanh toán đủ
  OVERDUE // Quá hạn thanh toán
  CANCELLED // Đã hủy
  REFUNDED // Đã hoàn tiền
}

enum PaymentMethod {
  CASH // Tiền mặt
  BANK_TRANSFER // Chuyển khoản ngân hàng
  VNPAY // Cổng thanh toán VNPay
  MOMO // Ví điện tử MoMo
}

enum PaymentStatus {
  PENDING // Đang xử lý
  SUCCESS // Thành công
  FAILED // Thất bại
  REFUNDED // Đã hoàn tiền
}

enum PromotionType {
  PERCENTAGE // Giảm theo phần trăm (%)
  FIXED_AMOUNT // Giảm số tiền cố định (VNĐ)
}

enum NotificationType {
  ACADEMIC // Thông báo học vụ (lớp học, lịch học)
  TUITION // Thông báo học phí, công nợ
  ATTENDANCE // Thông báo điểm danh, vắng học
  EXAM // Thông báo bài thi, kết quả
  SYSTEM // Thông báo hệ thống chung
}

// ------------------------------------------------------------------------------
// 1. CHI NHÁNH & PHÒNG HỌC (BRANCHES & ROOMS)
// ------------------------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid())
  code      String   @unique // Mã chi nhánh: BR-Q1, BR-BT, ...
  name      String // Tên chi nhánh: Chi nhánh Quận 1, ...
  address   String // Địa chỉ đầy đủ
  phone     String? // Số điện thoại liên hệ
  email     String? // Email chi nhánh
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms Room[]
  users User[]
  leads AdmissionLead[]
  classes Class[]

  @@map("branches")
}

model Room {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code      String // Mã phòng: P101, LAB-01...
  name      String // Tên phòng: Phòng Học 101...
  capacity  Int      @default(25) // Sức chứa tối đa của phòng
  equipment String? // Trang thiết bị: Máy chiếu, Loa, Bảng thông minh...
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes       Class[]
  classSessions ClassSession[]

  @@unique([branchId, code])
  @@map("rooms")
}

// ------------------------------------------------------------------------------
// 2. NGƯỜI DÙNG & PHÂN QUYỀN (USERS & RBAC)
// ------------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  userCode     String     @unique // Mã định danh: HV-2026-0001, GV-001, AD-001...
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  gender       Gender?
  dateOfBirth  DateTime?
  address      String?
  status       UserStatus @default(PENDING_ACTIVATION)
  isFirstLogin Boolean    @default(true) // Bắt buộc đổi mật khẩu khi đăng nhập lần đầu
  lastLoginAt  DateTime?
  fcmTokens    String[]   @default([]) // Danh sách FCM device token để bắn push notification

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Quan hệ phân quyền
  userRoles UserRole[]

  // Hồ sơ chuyên biệt
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  // Quan hệ phụ huynh - học viên
  parents  ParentStudent[] @relation("StudentRelation")
  children ParentStudent[] @relation("ParentRelation")

  // Quan hệ quản lý tư vấn tuyển sinh
  managedLeads AdmissionLead[] @relation("StaffLeadRelation")

  // Lớp học & Giảng dạy
  taughtClasses    Class[]        @relation("MainTeacherRelation")
  assistedClasses  Class[]        @relation("AssistantTeacherRelation")
  sessionTeachers  ClassSession[] @relation("SessionTeacherRelation")
  classEnrollments ClassStudent[]

  // Điểm danh & Học bù
  attendances            Attendance[]    @relation("StudentAttendanceRelation")
  markedAttendances      Attendance[]    @relation("MarkedByRelation")
  makeupRequests         MakeupRequest[] @relation("StudentMakeupRelation")
  approvedMakeupRequests MakeupRequest[] @relation("ApprovedByMakeupRelation")

  // Bài tập & Chấm điểm
  createdAssignments    Assignment[]    @relation("CreatedAssignmentsRelation")
  submissions           Submission[]    @relation("StudentSubmissionsRelation")
  gradedSubmissions     Submission[]    @relation("GradedSubmissionsRelation")

  // Ngân hàng câu hỏi & Đề thi (Exams)
  createdQuestionBanks  QuestionBank[]  @relation("CreatedQuestionBanksRelation")
  createdExams          Exam[]          @relation("CreatedExamsRelation")
  examAttempts          ExamAttempt[]   @relation("StudentExamAttemptsRelation")
  gradedExamAnswers     ExamAnswer[]    @relation("GradedExamAnswersRelation")

  // Tài chính & Học phí (Finance & Payments)
  studentInvoices       Invoice[]       @relation("StudentInvoicesRelation")
  createdInvoices       Invoice[]       @relation("CreatedInvoicesRelation")
  studentPayments       Payment[]       @relation("StudentPaymentsRelation")
  receivedPayments      Payment[]       @relation("ReceivedPaymentsRelation")

  // Thông báo (Notifications)
  notifications         Notification[]  @relation("UserNotificationsRelation")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique // super_admin, branch_admin, academic_staff, cashier, teacher, teaching_assistant, student, parent
  name        String // Tên hiển thị: Quản trị viên cấp cao, Giáo viên...
  description String?
  isSystem    Boolean  @default(false) // Quyền hệ thống mặc định không thể xóa
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // users.view, users.create, classes.manage, attendance.mark, ...
  name        String // Tên quyền: Xem danh sách người dùng, Điểm danh học viên...
  module      String // Module chức năng: users, classes, finance, attendance, exams, admissions
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedAt   DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------------------------
// 3. HỒ SƠ CHUYÊN BIỆT (PROFILES & RELATIONS)
// ------------------------------------------------------------------------------

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryLevel  String? // Trình độ đầu vào: Beginner, A2, IELTS 4.5...
  targetLevel String? // Mục tiêu học tập: B2, IELTS 6.5...
  schoolName  String? // Trường học hiện tại của học viên
  notes       String? // Ghi chú đặc biệt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("student_profiles")
}

model TeacherProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  degrees     String? // Bằng cấp chứng chỉ: Cử nhân ĐHSP, IELTS 8.5, TESOL...
  specialties String? // Chuyên môn giảng dạy: IELTS Speaking, Ngữ pháp, Giao tiếp...
  bio         String? // Giới thiệu bản thân
  hourlyRate  Decimal? @db.Decimal(12, 2) // Thù lao giảng dạy theo giờ (nếu có)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("teacher_profiles")
}

model ParentStudent {
  id               String   @id @default(uuid())
  parentId         String
  studentId        String
  parent           User     @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  student          User     @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)
  relationship     String? // Bố, Mẹ, Người giám hộ...
  isPrimaryContact Boolean  @default(true) // Người liên hệ nhận thông báo chính
  createdAt        DateTime @default(now())

  @@unique([parentId, studentId])
  @@map("parent_students")
}

// ------------------------------------------------------------------------------
// 4. TUYỂN SINH & TƯ VẤN (ADMISSIONS & LEADS)
// ------------------------------------------------------------------------------

model AdmissionLead {
  id           String     @id @default(uuid())
  fullName     String // Họ và tên người có nhu cầu học
  phone        String // Số điện thoại liên hệ
  email        String? // Email liên hệ
  targetCourse String? // Khóa học quan tâm (IELTS, Giao tiếp, Thiếu nhi...)
  source       LeadSource @default(WEBSITE)
  status       LeadStatus @default(NEW)
  notes        String? // Ghi chú tư vấn

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  assignedStaffId String? // Nhân viên học vụ được phân công chăm sóc
  assignedStaff   User?   @relation("StaffLeadRelation", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  convertedUserId String? // Lưu ID học viên nếu chuyển đổi thành công
  convertedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admission_leads")
}

// ------------------------------------------------------------------------------
// 5. KHÓA HỌC & GIÁO TRÌNH (COURSES & CURRICULUM)
// ------------------------------------------------------------------------------

model Course {
  id             String   @id @default(uuid())
  code           String   @unique // Mã khóa học: IELTS, COMM, KIDS, TOEIC...
  title          String   // Tiêu đề: Khóa học Luyện thi IELTS, Tiếng Anh Giao tiếp...
  description    String?  // Giới thiệu khóa học
  targetAudience String?  // Đối tượng: Học sinh THPT, Sinh viên, Người đi làm...
  language       String   @default("English") // Ngôn ngữ: English, Japanese, Korean, Chinese...
  thumbnailUrl   String?  // Ảnh đại diện
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  levels  CourseLevel[]
  classes Class[]

  @@map("courses")
}

model CourseLevel {
  id                String   @id @default(uuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code              String   // Mã cấp độ: FOUNDATION, BAND-5.5, BAND-6.5, ADVANCED...
  name              String   // Tên cấp độ: IELTS Foundation, IELTS 5.5 - 6.5...
  description       String?  // Mục tiêu chuẩn đầu ra của level
  order             Int      @default(1)
  estimatedSessions Int      @default(24) // Số buổi học dự kiến
  tuitionFee        Decimal  @db.Decimal(12, 2) @default(0) // Học phí mặc định cho cấp độ này
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  modules Module[]
  classes Class[]

  @@unique([courseId, code])
  @@map("course_levels")
}

model Module {
  id          String      @id @default(uuid())
  levelId     String
  level       CourseLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  title       String      // Tên module/chương: Listening & Speaking Fundamentals...
  order       Int         @default(1)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id              String   @id @default(uuid())
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String   // Tên bài học: Unit 1 - Personal Information & Greetings
  order           Int      @default(1)
  content         String?  // Nội dung tóm tắt hoặc giáo án (markdown/text)
  durationMinutes Int      @default(90) // Thời lượng buổi học (phút)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  materials     LessonMaterial[]
  classSessions ClassSession[]

  @@map("lessons")
}

model LessonMaterial {
  id            String           @id @default(uuid())
  lessonId      String
  lesson        Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title         String           // Tên tài liệu: Slide bài giảng Unit 1, File nghe Audio Track 01...
  fileUrl       String           // URL download/stream từ Firebase Storage
  fileType      MaterialFileType @default(DOCUMENT)
  fileSizeBytes Int?             // Dung lượng file (bytes)
  order         Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("lesson_materials")
}

// ------------------------------------------------------------------------------
// 6. LỚP HỌC & LỊCH HỌC (CLASSES & SESSIONS)
// ------------------------------------------------------------------------------

model Class {
  id                 String      @id @default(uuid())
  code               String      @unique // Mã lớp học: IELTS-F-2026-01, COMM-A1-02...
  name               String      // Tên hiển thị của lớp: IELTS Foundation T2-T4-T6
  courseId           String
  course             Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  levelId            String
  level              CourseLevel @relation(fields: [levelId], references: [id], onDelete: Restrict)
  branchId           String
  branch             Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roomId             String?
  room               Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  mainTeacherId      String?
  mainTeacher        User?       @relation("MainTeacherRelation", fields: [mainTeacherId], references: [id], onDelete: SetNull)
  assistantTeacherId String?
  assistantTeacher   User?       @relation("AssistantTeacherRelation", fields: [assistantTeacherId], references: [id], onDelete: SetNull)
  status             ClassStatus @default(PLANNING)
  startDate          DateTime    @db.Date
  endDate            DateTime?   @db.Date
  scheduleDays       String[]    @default([]) // Các ngày học trong tuần: ["MONDAY", "WEDNESDAY", "FRIDAY"]
  startTime          String      // Giờ bắt đầu: "18:00"
  endTime            String      // Giờ kết thúc: "19:30"
  totalSessions      Int         @default(24) // Tổng số buổi học
  maxCapacity        Int         @default(20) // Sĩ số tối đa
  tuitionFee         Decimal     @db.Decimal(12, 2) @default(0) // Học phí thực tế áp dụng cho lớp này
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  students    ClassStudent[]
  sessions    ClassSession[]
  assignments Assignment[]
  exams       Exam[]
  invoices    Invoice[]

  @@map("classes")
}

model ClassStudent {
  id          String           @id @default(uuid())
  classId     String
  class       Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId   String
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ENROLLED)
  joinedAt    DateTime         @default(now())
  tuitionPaid Decimal          @db.Decimal(12, 2) @default(0)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([classId, studentId])
  @@map("class_students")
}

model ClassSession {
  id            String        @id @default(uuid())
  classId       String
  class         Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  lessonId      String?
  lesson        Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  sessionNumber Int           // Buổi số 1, 2, 3...
  title         String        // Tên buổi học: Buổi 1: Unit 1 Greetings...
  date          DateTime      @db.Date // Ngày diễn ra
  startTime     String        // Giờ bắt đầu: "18:00"
  endTime       String        // Giờ kết thúc: "19:30"
  roomId        String?
  room          Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  teacherId     String?       // Giáo viên trực tiếp dạy buổi này
  teacher       User?         @relation("SessionTeacherRelation", fields: [teacherId], references: [id], onDelete: SetNull)
  status        SessionStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  attendances            Attendance[]
  originalMakeupRequests MakeupRequest[] @relation("OriginalSessionMakeupRelation")
  targetMakeupRequests   MakeupRequest[] @relation("TargetSessionMakeupRelation")

  @@unique([classId, sessionNumber])
  @@map("class_sessions")
}

// ------------------------------------------------------------------------------
// 7. ĐIỂM DANH & HỌC BÙ (ATTENDANCE & MAKEUP)
// ------------------------------------------------------------------------------

model Attendance {
  id          String           @id @default(uuid())
  sessionId   String
  session     ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId   String
  student     User             @relation("StudentAttendanceRelation", fields: [studentId], references: [id], onDelete: Cascade)
  status      AttendanceStatus @default(PRESENT)
  checkInTime DateTime?
  notes       String?
  markedById  String?
  markedBy    User?            @relation("MarkedByRelation", fields: [markedById], references: [id], onDelete: SetNull)
  markedAt    DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([sessionId, studentId])
  @@map("attendances")
}

model MakeupRequest {
  id                String        @id @default(uuid())
  studentId         String
  student           User          @relation("StudentMakeupRelation", fields: [studentId], references: [id], onDelete: Cascade)
  originalSessionId String
  originalSession   ClassSession  @relation("OriginalSessionMakeupRelation", fields: [originalSessionId], references: [id], onDelete: Cascade)
  targetSessionId   String?
  targetSession     ClassSession? @relation("TargetSessionMakeupRelation", fields: [targetSessionId], references: [id], onDelete: SetNull)
  status            MakeupStatus  @default(PENDING)
  reason            String?
  approvedById      String?
  approvedBy        User?         @relation("ApprovedByMakeupRelation", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("makeup_requests")
}

// ------------------------------------------------------------------------------
// 8. BÀI TẬP & NỘP BÀI (ASSIGNMENTS & SUBMISSIONS)
// ------------------------------------------------------------------------------

model Assignment {
  id          String         @id @default(uuid())
  classId     String
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User           @relation("CreatedAssignmentsRelation", fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        AssignmentType @default(HOMEWORK)
  status      AssignmentStatus @default(PUBLISHED)
  deadline    DateTime?
  maxScore    Decimal        @db.Decimal(5, 2) @default(10)
  attachments Json?          // Danh sách tài liệu đính kèm: [{ name, url, fileType, fileSizeBytes }]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String           @id @default(uuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User             @relation("StudentSubmissionsRelation", fields: [studentId], references: [id], onDelete: Cascade)
  content      String?          // Nội dung văn bản / essay
  fileUrls     Json?            // Danh sách file nộp: [{ type: "audio"|"document"|"image", url: "...", name: "..." }]
  submittedAt  DateTime?
  score        Decimal?         @db.Decimal(5, 2)
  feedback     String?          // Nhận xét của giáo viên
  gradedById   String?
  gradedBy     User?            @relation("GradedSubmissionsRelation", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt     DateTime?
  resultPublishedAt DateTime?
  status       SubmissionStatus @default(SUBMITTED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

// ------------------------------------------------------------------------------
// 9. NGÂN HÀNG CÂU HỎI & ĐỀ THI (QUESTION BANKS & EXAMS)
// ------------------------------------------------------------------------------

model QuestionBank {
  id          String     @id @default(uuid())
  title       String
  description String?
  language    String?    // 'EN', 'JA', 'KO', 'ZH'...
  level       String?    // 'A1', 'A2', 'B1', 'B2', 'IELTS', 'TOEIC'...
  createdById String
  createdBy   User       @relation("CreatedQuestionBanksRelation", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions Question[]

  @@map("question_banks")
}

model Question {
  id             String       @id @default(uuid())
  questionBankId String
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)
  type           QuestionType @default(MULTIPLE_CHOICE)
  prompt         String       // Đề bài hoặc câu hỏi
  audioUrl       String?      // Audio cho bài thi nghe
  imageUrl       String?      // Hình ảnh minh họa
  options        Json?        // Lựa chọn: [{ id: "A", text: "..." }]
  correctAnswers Json?        // Đáp án đúng: ["A"] hoặc ["is", "are"] hoặc {"A": "1"}
  explanation    String?      // Giải thích chi tiết
  points         Decimal      @db.Decimal(5, 2) @default(1.0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  examQuestions ExamQuestion[]

  @@map("questions")
}

model Exam {
  id               String       @id @default(uuid())
  title            String
  description      String?
  classId          String?
  class            Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  durationMinutes  Int          @default(45)
  passPercentage   Decimal      @db.Decimal(5, 2) @default(50.0)
  totalPoints      Decimal      @db.Decimal(5, 2) @default(10.0)
  shuffleQuestions Boolean      @default(false)
  maxAttempts      Int          @default(1)
  status           ExamStatus   @default(DRAFT)
  startTime        DateTime?
  endTime          DateTime?
  createdById      String
  createdBy        User         @relation("CreatedExamsRelation", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  examQuestions ExamQuestion[]
  attempts      ExamAttempt[]

  @@map("exams")
}

model ExamQuestion {
  id         String   @id @default(uuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex Int      @default(0)
  points     Decimal  @db.Decimal(5, 2) @default(1.0)

  answers ExamAnswer[]

  @@unique([examId, questionId])
  @@map("exam_questions")
}

model ExamAttempt {
  id            String        @id @default(uuid())
  examId        String
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId     String
  student       User          @relation("StudentExamAttemptsRelation", fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber Int           @default(1)
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  score         Decimal?      @db.Decimal(5, 2)
  maxScore      Decimal       @db.Decimal(5, 2) @default(10.0)
  isPassed      Boolean?
  status        AttemptStatus @default(IN_PROGRESS)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  answers ExamAnswer[]

  @@map("exam_attempts")
}

model ExamAnswer {
  id              String       @id @default(uuid())
  attemptId       String
  attempt         ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestionId  String
  examQuestion    ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  studentAnswer   Json?        // Đáp án học viên chọn hoặc nhập
  isCorrect       Boolean?
  score           Decimal?     @db.Decimal(5, 2)
  teacherFeedback String?
  gradedById      String?
  gradedBy        User?        @relation("GradedExamAnswersRelation", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt        DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([attemptId, examQuestionId])
  @@map("exam_answers")
}

// ------------------------------------------------------------------------------
// 10. HỌC PHÍ & TÀI CHÍNH (FINANCE, INVOICES & PAYMENTS)
// ------------------------------------------------------------------------------

model Promotion {
  id            String        @id @default(uuid())
  code          String        @unique // Mã khuyến mãi: SUMMER2026, EARLYBIRD...
  name          String        // Tên chương trình ưu đãi
  description   String?
  type          PromotionType @default(PERCENTAGE)
  value         Decimal       @db.Decimal(12, 2) // Giá trị giảm: 10 (%) hoặc 500000 (VNĐ)
  minOrderValue Decimal?      @db.Decimal(12, 2) // Giá trị hóa đơn tối thiểu để áp dụng
  maxDiscount   Decimal?      @db.Decimal(12, 2) // Mức giảm tối đa (đối với %)
  startDate     DateTime      @db.Date
  endDate       DateTime      @db.Date
  usageLimit    Int?          // Giới hạn số lượt sử dụng toàn hệ thống
  usedCount     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  invoices Invoice[]

  @@map("promotions")
}

model Invoice {
  id          String        @id @default(uuid())
  code        String        @unique // Mã hóa đơn: HD-2026-0001
  title       String        // Tiêu đề: Học phí IELTS Foundation K01
  studentId   String
  student     User          @relation("StudentInvoicesRelation", fields: [studentId], references: [id], onDelete: Cascade)
  classId     String?
  class       Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  subtotal    Decimal       @db.Decimal(12, 2) // Học phí gốc
  discount    Decimal       @db.Decimal(12, 2) @default(0) // Giảm giá / Khuyến mãi
  totalAmount Decimal       @db.Decimal(12, 2) // Tổng tiền phải nộp sau giảm trừ
  paidAmount  Decimal       @db.Decimal(12, 2) @default(0) // Số tiền đã thanh toán
  balance     Decimal       @db.Decimal(12, 2) // Số tiền còn lại phải trả
  status      InvoiceStatus @default(PENDING)
  dueDate     DateTime?     @db.Date // Hạn chót thanh toán
  issuedDate  DateTime      @default(now()) @db.Date // Ngày lập hóa đơn
  notes       String?       // Ghi chú thêm
  promotionId String?
  promotion   Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?         @relation("CreatedInvoicesRelation", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments Payment[]

  @@map("invoices")
}

model Payment {
  id            String        @id @default(uuid())
  code          String        @unique // Mã phiếu thu: PT-2026-0001
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  studentId     String
  student       User          @relation("StudentPaymentsRelation", fields: [studentId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(12, 2) // Số tiền thanh toán lần này
  method        PaymentMethod @default(CASH)
  status        PaymentStatus @default(SUCCESS)
  transactionId String?       // Mã giao dịch ngân hàng / VNPay / MoMo
  payDate       DateTime      @default(now())
  notes         String?
  receivedById  String?
  receivedBy    User?         @relation("ReceivedPaymentsRelation", fields: [receivedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

// ------------------------------------------------------------------------------
// 11. THÔNG BÁO HỆ THỐNG & PUSH NOTIFICATIONS
// ------------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserNotificationsRelation", fields: [userId], references: [id], onDelete: Cascade)
  title     String           // Tiêu đề thông báo
  body      String           // Nội dung thông báo
  type      NotificationType @default(SYSTEM)
  data      Json?            // Payload phụ trợ: { entityType: "INVOICE", entityId: "..." }
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("notifications")
}
