# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION — LMS TRUNG TÂM NGOẠI NGỮ
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=lms_password_dev
POSTGRES_PORT=5432
# Chuỗi kết nối dùng cho NestJS / Prisma ORM
DATABASE_URL=postgresql://lms_user:lms_password_dev@localhost:5432/lms_db?schema=public

# ------------------------------------------------------------------------------
# 2. CACHE & QUEUE (Redis)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. DATABASE WEB MANAGER (Adminer)
# ------------------------------------------------------------------------------
ADMINER_PORT=8080

# ------------------------------------------------------------------------------
# 4. BACKEND API (NestJS)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# ------------------------------------------------------------------------------
# 5. JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET=lms_super_secret_access_key_change_in_production_2026
JWT_REFRESH_SECRET=lms_super_secret_refresh_key_change_in_production_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 6. FIREBASE SERVICES
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=lms-ngoai-ngu-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@lms-ngoai-ngu-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=lms-ngoai-ngu-dev.appspot.com

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAY (VNPay Sandbox)
# ------------------------------------------------------------------------------
VNPAY_TMN_CODE=TEST_TMN_CODE
VNPAY_HASH_SECRET=TEST_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/v1/finance/payments/vnpay-return
